{
  "name": "social-hub",
  "productName": "Social Hub",
  "version": "0.1.0",
  "description": "Gerencie, analise e agende publicações nas suas redes sociais com IA e MCP.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode web",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --publish never",
    "cap:sync": "npm run build:web && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --android",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.2.0"
  },
  "author": {
    "name": "Emerson Gonçalves",
    "email": "esgboy@gmail.com"
  },
  "homepage": "https://github.com/emersonsg01/Social-Midia",
  "repository": {
    "type": "git",
    "url": "https://github.com/emersonsg01/Social-Midia.git"
  }
}
